{
    "database": {
        "pool_size": 5,
        "timeout": 30,
        "retry_attempts": 3
    },
    "ui": {
        "theme": "default",
        "date_format": "%Y-%m-%d",
        "currency_symbol": "$"
    },
    "analysis": {
        "default_ma_period": 20,
        "default_rsi_period": 14,
        "macd_fast": 12,
        "macd_slow": 26,
        "macd_signal": 9
    },
    "watchlist": {
        "auto_refresh": true,
        "refresh_interval_minutes": 30
    },
    "logging": {
        "level": "INFO",
        "log_to_file": true,
        "log_path": "logs"
    },
    "chart": {
        "default_theme": "dark",
        "auto_save": true,
        "save_path": "charts"
    },
    "trading_strategies": {
        "enabled": true,
        "auto_evaluate_on_data_update": false,
        "signal_expiration_days": 7,
        "min_confidence_threshold": 70.0,
        "max_signals_per_ticker_per_day": 3,
        "auto_create_ai_recommendation": true,
        "ai_recommendation_min_confidence": 75.0,
        "backtest_default_capital": 10000.0,
        "backtest_transaction_cost": 5.0
    }
}